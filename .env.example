# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_analyst

# SEC EDGAR requires a User-Agent with your name and contact email
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM (model names are filled in Task 0.4)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=

# API: JSON list of accepted X-API-Key values
API_KEYS=["change-me"]

# Langfuse Cloud tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Web UI origin allowed by CORS
WEB_ORIGIN=http://localhost:3000
